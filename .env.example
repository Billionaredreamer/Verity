# ---------------------------------------------------------------------------
# Verity environment configuration
#
# Handover §10: never expose provider keys, brokerage tokens, database
# credentials or AI keys to the client. Nothing in this file may be prefixed
# NEXT_PUBLIC_ except the two explicitly-public flags at the bottom.
#
# Copy to `.env.local` and fill in. `.env.local` is gitignored.
# ---------------------------------------------------------------------------

# --- Data source selection -------------------------------------------------
# Which adapter set the server uses. `mock` requires no keys and is the
# default for local development. See src/lib/providers/registry.ts.
#   mock | polygon | alpaca | finnhub | twelvedata
VERITY_MARKET_PROVIDER=mock
#   mock | polygon | tradier | thetadata | intrinio
VERITY_OPTIONS_PROVIDER=mock
#   mock | finnhub | benzinga | polygon
VERITY_NEWS_PROVIDER=mock
#   mock | alpaca | tradier | ibkr | snaptrade
VERITY_BROKERAGE_PROVIDER=mock

# --- Market data -----------------------------------------------------------
POLYGON_API_KEY=
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=

# --- Options ---------------------------------------------------------------
TRADIER_ACCESS_TOKEN=
THETADATA_API_KEY=
INTRINIO_API_KEY=

# --- News ------------------------------------------------------------------
BENZINGA_API_KEY=

# --- Brokerage (read-only scopes only in V1 — handover §7, §12) ------------
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
IBKR_OAUTH_CONSUMER_KEY=

# --- AI reasoning layer ----------------------------------------------------
ANTHROPIC_API_KEY=
# Speech-to-text / text-to-speech for the Terminal voice path (§3).
VERITY_STT_API_KEY=
VERITY_TTS_API_KEY=

# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql://localhost:5432/verity

# --- Auth ------------------------------------------------------------------
AUTH_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Public flags (safe to ship to the browser) ----------------------------
# Shown in the UI so a trader always knows what they are looking at.
NEXT_PUBLIC_VERITY_ENV=development
